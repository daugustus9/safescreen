    <!-- Transparency -->
    <string name="transparency_title">O que o SafeScreen vê e compartilha</string>
    <string name="transparency_intro">O SafeScreen ajuda você a ficar seguro e organizado. Isto é exatamente o que ele faz. Nada fica escondido.</string>
    <string name="transparency_checks_title">Neste celular, o SafeScreen:</string>
    <string name="transparency_checks_1">Verifica as palavras que você digita em busca de riscos sérios, como automutilação ou desafios perigosos. As palavras são verificadas e esquecidas na hora.</string>
    <string name="transparency_checks_2">Lê avisos apenas dos apps da escola que sua família escolheu, para lembrar você de provas e tarefas.</string>
    <string name="transparency_checks_3">Mostra, de tempos em tempos, cartões de segurança, conselhos e escola.</string>
    <string name="transparency_checks_4">Pausa os apps combinados enquanto o tempo de foco está rodando.</string>
    <string name="transparency_parents_title">Seus pais veem:</string>
    <string name="transparency_parents_1">Alertas só com a categoria, como \"desafio perigoso\".</string>
    <string name="transparency_parents_2">Quando você toca em \"Preciso de ajuda\".</string>
    <string name="transparency_parents_3">Um resumo semanal: tempo de tela, tarefas da escola e minutos de foco.</string>
    <string name="transparency_never_title">Seus pais nunca veem:</string>
    <string name="transparency_never_1">O que você digita, suas mensagens ou suas fotos.</string>
    <string name="transparency_never_2">Os sites ou vídeos que você abre.</string>
    <string name="transparency_offline">O SafeScreen não tem acesso à internet. Tudo fica neste celular.</string>
    <string name="transparency_continue">Entendi</string>

    <!-- Setup -->
    <string name="setup_title">Configurar o SafeScreen</string>
    <string name="setup_intro">Cada acesso é ligado nas configurações do Android. Você pode desligar qualquer um a qualquer momento.</string>
    <string name="access_overlay_title">Mostrar cartões sobre outros apps</string>
    <string name="access_overlay_desc">Para cartões de segurança, conselhos e escola.</string>
    <string name="access_accessibility_title">Verificação de segurança e modo foco</string>
    <string name="access_accessibility_desc">Verifica palavras digitadas em busca de riscos sérios e pausa apps no tempo de foco.</string>
    <string name="access_listener_title">Avisos dos apps da escola</string>
    <string name="access_listener_desc">Lê avisos apenas dos apps da escola que sua família escolher.</string>
    <string name="access_usage_title">Tempo de tela</string>
    <string name="access_usage_desc">Minutos por app para o resumo semanal.</string>
    <string name="access_notifications_title">Notificações</string>
    <string name="access_notifications_desc">Mostra que o SafeScreen está ligado e os alertas de segurança.</string>
    <string name="access_granted">Ligado</string>
    <string name="access_grant">Ligar</string>
    <string name="setup_restricted_note">Se o Android disser que a configuração é restrita: abra Configurações › Apps › SafeScreen, toque em ⋮ e escolha \"Permitir configurações restritas\". Isso acontece com apps instalados fora da Play Store.</string>

