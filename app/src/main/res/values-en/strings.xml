    <!-- Transparency -->
    <string name="transparency_title">What SafeScreen sees and shares</string>
    <string name="transparency_intro">SafeScreen helps keep you safe and organized. This is exactly what it does. Nothing is hidden.</string>
    <string name="transparency_checks_title">On this phone, SafeScreen:</string>
    <string name="transparency_checks_1">Checks words you type for serious risks, like self-harm or dangerous challenges. The words are checked and forgotten right away.</string>
    <string name="transparency_checks_2">Reads notices only from the school apps your family picked, to remind you about tests and homework.</string>
    <string name="transparency_checks_3">Shows safety, advice, encouragement and school cards every so often, long enough to read. You can read every one of them in \"All messages\".</string>
    <string name="transparency_checks_4">Pauses the apps you agreed on while focus time is running.</string>
    <string name="transparency_parents_title">Your parents see:</string>
    <string name="transparency_parents_1">Alerts with a category only, like \"dangerous challenge\".</string>
    <string name="transparency_parents_2">When you tap \"I need help\".</string>
    <string name="transparency_parents_3">A weekly summary: screen time, school tasks, focus minutes and questions answered.</string>
    <string name="transparency_never_title">Your parents never see:</string>
    <string name="transparency_never_1">What you type, your messages or your photos.</string>
    <string name="transparency_never_2">The websites or videos you open.</string>
    <string name="transparency_offline">SafeScreen has no internet access. Everything stays on this phone.</string>
    <string name="transparency_continue">I understand</string>

